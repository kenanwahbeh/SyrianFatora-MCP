{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syrianfatora-mcp-oauth-preview",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "MCP_SERVER_URL": "https://replace-with-mcp-preview-host.invalid/mcp",
    "AUTH_SERVER_URL": "https://replace-with-auth-preview-host.invalid"
  },
  "services": [
    {
      "binding": "AUTH_SERVER",
      "service": "syrianfatora-auth-preview",
      "entrypoint": "SyrianFatoraAuth"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
